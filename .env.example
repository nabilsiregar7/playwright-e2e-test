# copy to .env and fill in - never commit the real .env
BASE_URL=https://app.sleekflow.io

# account that already exists
LOGIN_EMAIL=
LOGIN_PASSWORD=

# signup uses plus-addressing so every run gets a unique email e.g email+sleekflowqa@gmail.com
SIGNUP_EMAIL_BASE=

# the real signup test creates an account, default off
ALLOW_REAL_SIGNUP=false

# slow down each browser action (ms) when watching a headed run, 0 = full speed
SLOW_MO=0
