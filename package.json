{
  "name": "sleekflow-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright tests for Sleekflow login and signup",
  "scripts": {
    "test": "playwright test",
    "test:headed": "SLOW_MO=500 playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "test:login": "playwright test tests/login.spec.ts",
    "test:signup": "playwright test tests/signup.spec.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://sleekflow.io"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
